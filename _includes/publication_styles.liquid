{%- comment -%}
  Paper list styles shared by the homepage (selected papers) and the publications page:
  each paper is a soft rounded card with its thumbnail centered vertically, and the venue is a small blue pill
  (grey for arXiv preprints; the hook in _includes/hook/bib.liquid adds the venue-preprint class).
{%- endcomment -%}
<style>
  :root {
    --paper-card-bg: #f6f7f9;
    --venue-bg: #e6effa;
    --venue-color: #2f5f9e;
    --venue-preprint-bg: rgba(96, 107, 112, 0.11);
    --venue-preprint-color: #606b70;
  }
  html[data-theme="dark"] {
    --paper-card-bg: rgba(255, 255, 255, 0.04);
    --venue-bg: rgba(110, 165, 255, 0.16);
    --venue-color: #a8c8ff;
    --venue-preprint-bg: rgba(255, 255, 255, 0.08);
    --venue-preprint-color: #a6b0b4;
  }
  .publications ol.bibliography li {
    background-color: var(--paper-card-bg);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }
  /* al-folio hides closed abstracts behind a dashed border in the page color, which shows up on the card */
  .publications ol.bibliography li div.abstract.hidden {
    border-color: transparent;
  }
  .publications ol.bibliography li div.abstract.hidden.open {
    border-color: var(--global-text-color);
  }
  .publications ol.bibliography li .abbr figure {
    margin-bottom: 0;
  }
  .publications ol.bibliography li .preview {
    display: block;
  }
  .publications .venue {
    display: inline-block;
    margin: 0.35rem 0 0.1rem;
    padding: 0.05rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    background-color: var(--venue-bg);
    color: var(--venue-color);
  }
  .publications .venue-preprint {
    background-color: var(--venue-preprint-bg);
    color: var(--venue-preprint-color);
  }
  /* keep paper thumbnails mini on phones (al-folio stretches them to full width) */
  @media (max-width: 575.98px) {
    .publications .preview {
      max-width: 45%;
    }
  }
  /* thumbnail centered between the top and bottom of the card */
  @media (min-width: 576px) {
    .publications ol.bibliography li .row {
      align-items: center;
    }
    .publications ol.bibliography li .abbr {
      margin-bottom: 0;
    }
  }
</style>
