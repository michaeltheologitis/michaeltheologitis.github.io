{%- comment -%}
  al-folio's bib layout includes this hook right before it prints the venue line under each paper.
  When an entry has a short `venue` (e.g. "NeurIPS 2026", "Preprint"), show just that instead of
  "In <booktitle>, <year>", as a small pill (styled in _includes/publication_styles.liquid).
{%- endcomment -%}
{%- if entry.venue -%}
  {%- capture entrytype -%}<span class="venue">{{ entry.venue }}</span>{%- endcapture -%}
  {%- assign entrymonth = '' -%}
  {%- assign entryyear = '' -%}
{%- endif -%}
